  <transform>
    <type>TableInput</type>
    <name>export_internacoes_sem_faturamento_despesa_assist</name>
    <sql>WITH 
internacoes_criticas AS (
    SELECT
        TRUNC(ap.data_autorizacao, 'MM') AS dt_competencia,
        CASE 
            WHEN LENGTH(ap.cpf_cnpj_credenciado) &lt; 11 THEN LPAD(ap.cpf_cnpj_credenciado, 11, '0')
            WHEN LENGTH(ap.cpf_cnpj_credenciado) > 11 AND LENGTH(ap.cpf_cnpj_credenciado) &lt; 14 THEN LPAD(ap.cpf_cnpj_credenciado, 14, '0')
            ELSE TO_CHAR(ap.cpf_cnpj_credenciado)
        END AS cpf_cnpj_credenciado,
        ap.nome_credenciado,
        ap.cd_senha,
        ap.guia,
        ap.cod_beneficiario,
        ap.data_autorizacao,
        ap.dt_previsao_alta,
        ap.ds_tipo_internacao,
        ap.vl_total AS vl_autorizado/*,
        TRUNC(SYSDATE) - TRUNC(ap.dt_alta) AS dias_pos_alta_sem_fatura*/
    FROM bi.bi_autorizacao_procedimento ap
    WHERE 
        ap.data_autorizacao BETWEEN add_months(trunc(sysdate, 'month'),-12) AND add_months(trunc(sysdate, 'month'),-1)
        AND ap.cd_tipo_internacao IN (1, 2, 3, 4, 5)
        AND ap.cod_status_autor IN (1, 2)
        AND NOT EXISTS (
            SELECT 1 
            FROM 	bi.tb_consolidacao_despesa d
            WHERE d.dt_producao BETWEEN add_months(trunc(sysdate, 'month'),-16) AND add_months(trunc(sysdate, 'month'),-1)
              AND d.cd_senha &lt;&gt; '0'
              AND (d.cd_senha = ap.cd_senha OR d.nu_guia_atendimento = ap.guia)
        )
)
SELECT
    TO_CHAR(dt_competencia, 'MM-YYYY') AS COMPETENCIA_ALTA,
    cpf_cnpj_credenciado,
    nome_credenciado,
    cd_senha,
    guia,
    cod_beneficiario,
    data_autorizacao,
    dt_previsao_alta,
    ds_tipo_internacao,
    ROUND(vl_autorizado, 2) AS VL_AUTORIZADO
FROM
    internacoes_criticas
ORDER BY
    dt_competencia DESC,
    vl_autorizado DESC</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>Cn_Oracle_Afrafep</connection>
