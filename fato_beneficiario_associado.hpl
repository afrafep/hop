  <transform>
    <type>TableInput</type>
    <name>export_beneficario_associado</name>
    <sql>SELECT
    CD_BENEFICIARIO,
    MATRICULA,
    ORIGEM,
    NM_BENEFICIARIO,
    DT_NASCIMENTO,
    CPF,
    FL_SEXO,
    DS_TIPO_DEPENDENTE,
    PLANO,
    DS_LOGRADOURO,
    NM_BAIRRO,
    NM_CIDADE,
    TELEFONE,
    CELULAR,
    EMAIL,
    DT_ADESAO,
    DT_ULTIMA_REATIVACAO,
    DT_ULTIMO_CANCELAMENTO, 
    STATUS_USUARIO
FROM 
(SELECT 
    CD_BENEFICIARIO,
    CD_MATRICULA AS MATRICULA,
    'SAUDE' AS ORIGEM,
    NM_BENEFICIARIO,
    DT_NASCIMENTO,
    LPAD(NU_CPF,11,0) AS CPF,
    FL_SEXO AS FL_SEXO,
    DS_TIPO_DEPENDENTE,
    CD_PLANO_INTERNO AS PLANO,
    DS_LOGRADOURO,
    NM_BAIRRO,
    NM_CIDADE,
    TELEFONE,
    CELULAR,
    EMAIL,
    DT_ADESAO,
    DT_ULTIMA_REATIVACAO,
    DT_ULTIMO_CANCELAMENTO, 
    DS_SITUACAO_BENEFICIARIO AS STATUS_USUARIO
FROM (
    SELECT 
        CD_BENEFICIARIO, CD_MATRICULA, NM_BENEFICIARIO, DT_NASCIMENTO, NU_CPF, FL_SEXO, DS_TIPO_DEPENDENTE,
        CD_PLANO_INTERNO, DS_LOGRADOURO, NM_BAIRRO, NM_CIDADE, TELEFONE, CELULAR, EMAIL, DT_ADESAO, 
        DT_ULTIMA_REATIVACAO, DT_ULTIMO_CANCELAMENTO, DS_SITUACAO_BENEFICIARIO,
        ROW_NUMBER() OVER (PARTITION BY CD_BENEFICIARIO ORDER BY DT_ADESAO DESC) as RN
    FROM BI.BI_CADASTRO_BENEFICIARIO
) WHERE RN = 1
UNION ALL
SELECT 
    CD_BENEFICIARIO,
    MATRICULA,
    'SOCIAL',
    NM_BENEFICIARIO,
    DT_NASCIMENTO,
    LPAD(CPF,11,0),
    SEXO,
    GRAU_PARENTESCO,
    PLANO,
    NM_RUA_ENDERECO_A,
    NM_BAIRRO_ENDERECO_A,
    NM_CIDADE_ENDERECO_A,
    NU_TELEFONE ,
    CELULAR,
    EMAIL,
    DT_ADESAO_9999,
    DT_ULTIMA_REATIVACAO,
    DT_CANCEL_9999,
    DS_STATUS_USUARIO 
FROM (
    SELECT 
        CD_BENEFICIARIO,MATRICULA, NM_BENEFICIARIO, DT_NASCIMENTO, CPF, GRAU_PARENTESCO, SEXO,PLANO ,
        NM_RUA_ENDERECO_A, NM_BAIRRO_ENDERECO_A, NM_CIDADE_ENDERECO_A, NU_TELEFONE, CELULAR, EMAIL,
        DT_ADESAO_9999, NULL AS DT_ULTIMA_REATIVACAO,DT_CANCEL_9999 , DS_STATUS_USUARIO ,
        ROW_NUMBER() OVER (PARTITION BY CD_BENEFICIARIO ORDER BY DT_ADESAO_9999 DESC) as RN
    FROM BI.BI_BENEFICIARIO_SOCIAL
) WHERE RN = 1)</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>Cn_Oracle_Afrafep</connection>
