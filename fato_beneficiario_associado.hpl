  <transform>
    <type>TableInput</type>
    <name>export_beneficiario_demais_dados</name>
    <sql>SELECT 
*
FROM 
(WITH BASE_UNIFICADA AS (
    SELECT CD_MATRICULA, CD_BENEFICIARIO, NU_USUARIO, NU_TITULAR, NU_USUARIO_REFERENCIA, 'SAUDE' AS FONTE, CD_USUARIO_TIT, 
    CD_CCO || CASE WHEN LENGTH(CD_CCO) IS NULL THEN NULL ELSE '-' END || DV_CCO  AS CCO, QT_COTA_ATUAL, CD_UM_COTA , 
    CD_EMPRESA_CONVENIADA, CD_SERVICO_USUARIO_01 AS CD_SERVICO, 'ASSITENCIA MEDICA' AS DS_SERVICO, NULL AS VL_SERVICO,
    NULL AS DT_OPCAO_SERVICO, NULL AS DT_CANCELAMENTO_SERVICO,CD_SERVICO_USUARIO_05 AS SERVICO_AMBULANCIA, CD_FORMA_PAGAMENTO,
    DS_FORMA_ENVIO, DS_SITUACAO_TITULAR
    FROM BI.BI_CADASTRO_BENEFICIARIO
    UNION ALL
    SELECT MATRICULA, CD_BENEFICIARIO, NULL , NULL, NULL, 'SOCIAL', NULL,
    NULL, NULL, NULL, NULL,CD_SERVICO, DS_SERVICO, VL_SERVICO,
    DT_OPCAO_SERVICO, DT_CANCELAMENTO_SERVICO, NULL,CD_FORMA_PAGAMENTO_SOCIAL,
    DS_FORMA_ENVIO, DS_SITUACAO_TITULAR 
    FROM BI.BI_BENEFICIARIO_SOCIAL
)
SELECT 
	CD_MATRICULA,
	CD_BENEFICIARIO,
	NU_USUARIO,
	NU_TITULAR,
	NU_USUARIO_REFERENCIA,
    FONTE,
    CD_USUARIO_TIT,
    CCO,
	QT_COTA_ATUAL,
	CD_UM_COTA ,
	CD_EMPRESA_CONVENIADA,    
	CD_SERVICO,
	DS_SERVICO,
	VL_SERVICO,
	DT_OPCAO_SERVICO,
	DT_CANCELAMENTO_SERVICO,
	SERVICO_AMBULANCIA,
	CD_FORMA_PAGAMENTO,
	DS_FORMA_ENVIO,
	DS_SITUACAO_TITULAR
FROM BASE_UNIFICADA)</sql>
