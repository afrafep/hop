  <transform>
    <type>TableInput</type>
    <name>autorizacoes</name>
    <sql>SELECT
  CD_SENHA
, GUIA
, CD_SENHA_PRINCIPAL
, GUIA_PRINCIPAL
, CD_TOKEN
, DT_TOKEN
, DT_CONFIRMACAO_TOKEN
, CASE 
		WHEN LENGTH(CPF_CNPJ_CREDENCIADO) &lt; 11 THEN LPAD(CPF_CNPJ_CREDENCIADO,11,0)
		WHEN LENGTH(CPF_CNPJ_CREDENCIADO) > 11 AND  LENGTH(CPF_CNPJ_CREDENCIADO) &lt; 14 THEN LPAD(CPF_CNPJ_CREDENCIADO,14,0)
		ELSE TO_CHAR(CPF_CNPJ_CREDENCIADO)
  END AS CPF_CNPJ_CREDENCIADO
, NOME_CREDENCIADO
, NOME_PROF_EXEC
, NOME_PROF_SOLIC
, DATA_AUTORIZACAO
, DATA_SOLICITACAO
, COD_BENEFICIARIO
, COD_PROCEDIMENTO
, COD_TUSS
, COD_TAB_TUSS
, DESC_PROCEDIMENTO
, QT_PROCEDIMENTO
, VL_UNITARIO
, VL_TOTAL
, DESC_TIPO_AUTOR
, COD_OPERADOR
, NOME_OPERADOR
, DATA_ULT_ATUALIZACAO
, OBSERVACAO
, COD_PROGRAMA
, DESC_PROGRAMA
, COD_STATUS_AUTOR
, DESC_STATUS_AUTOR
, DT_AUDIT_ENFERMAGEM
, DT_PREVISAO_ALTA
, DT_ALTA
, NU_CBO_EXECUTANTE
, NU_CBO_SOLICITANTE
, CD_TIPO_INTERNACAO
, DS_TIPO_INTERNACAO
FROM BI.BI_AUTORIZACAO_PROCEDIMENTO
WHERE DATA_AUTORIZACAO BETWEEN add_months(trunc(sysdate, 'month'),-48) 
		AND add_months(trunc(sysdate, 'month'),-0)</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>Cn_Oracle_Afrafep</connection>
    <lookup/>
