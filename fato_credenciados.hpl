  <transform>
    <type>TableInput</type>
    <name>export_credenciados</name>
    <sql>select distinct 
	CASE WHEN p.FL_PRESTADOR = 1 THEN 'PF' ELSE 'PJ' END AS tipo_pessoa,
	p.CD_PESSOA,
	p.NU_CONTRATO_PRESTADOR,
	CASE 
		WHEN LENGTH(p.NU_CGC_CPF) &lt; 11 THEN LPAD(p.NU_CGC_CPF,11,0)
		WHEN LENGTH(p.NU_CGC_CPF) > 11 AND  LENGTH(p.NU_CGC_CPF) &lt; 14 THEN LPAD(p.NU_CGC_CPF,14,0)
		ELSE TO_CHAR(p.NU_CGC_CPF)
	END AS nu_cpf_cnpj,
	p.DT_NASCIMENTO_FUNDACAO,
	p.NM_PESSOA_RAZAO_SOCIAL,
	p.NM_FANTASIA,
	p.NM_REPRESENTANTE_LEGAL,
	-- p.NM_RESPONSAVEL_TECNICO,
	p.NU_CRM,
	p.CD_UF_CRM,
	p.CD_TIPO_CRM,
	p.CD_CBO,
	p.NM_CBO,
	(select max(t.CD_ESP_PRESTADOR||' - '||t.ds_especialidade)
	from VW_ESP_PRESTADORES t
	where 1 = 1
	and t.CD_PESSOA  = p.CD_PESSOA
	and t.fl_principal = '1' ) ds_especialidade_principal,
	p.CD_CNES,
	p.FL_REDE_PROPRIA,
	p.CD_TIPO_SERVICO_SAUDE AS cd_tipo_atendimento,
	p.CD_TIPO_TRANSACAO,
	p.CD_TIPO_LOGRADOURO || ' ' || p.NM_RUA_ENDERECO AS nm_endereco,
	p.DS_COMPL_ENDERERO AS nm_compl_endereco,
	p.NU_ENDERECO AS nu_endereco,
	p.NM_BAIRRO_ENDERECO AS nm_bairro_endereco,
	p.NM_CIDADE_ENDERECO AS nm_cidade_endereco,
	p.CD_UF_ENDERECO AS cd_uf_endereco,
	p.CD_CEP_ENDERECO AS cd_cep_endereco,
	p.DS_EMAIL AS email,
	p.NU_MEIO_COMUNICACAO AS telefone_celular,
	p.DT_CADASTRAMENTO,
	p.DT_CONTRATO,
	p.DT_CANCELAMENTO,
	p.DT_STATUS,
	p.FL_STATUS,
	p.CD_MOTIVO_DESCRED,
	p.DT_ENVIO_ARPS,
	p.CD_CLASSIFICACAO_ARPS,
	p.CD_NATUREZA_JURIDICA,
	CASE 
		WHEN p.FL_DISPONIBILIDADE = 'P' THEN 'Parcial'
		WHEN p.FL_DISPONIBILIDADE = 'T' THEN 'Total'
		ELSE NULL 
	END AS disponibilidade,
	p.FL_URGENCIA,
	p.FL_CALCULA_ISS,
	p.PC_ISS,
	p.FL_CALCULA_IRRF,
	p.PC_IRRF,
	p.FL_CALCULA_COFINS,
	p.PC_COFINS,
	p.FL_CALCULA_PIS,
	p.PC_PIS,
	p.FL_CALCULA_CSLL,
	p.PC_CSLL,
	p.FL_INSS,
	p.PC_INSS,
	p.PC_PIS_COFINS_CSLL,
	p.CD_UM_FILME,
	p.PC_FATOR_FILME,
	p.FL_AUDITOR
from VW_PRESTADORES p
where p.NU_CGC_CPF is not null</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>Cn_Oracle_Afrafep</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
