  <transform>
    <type>TableInput</type>
    <name>export_codificacao_tuss</name>
    <sql>SELECT 
	x.CD_TUSS,
	x.DS_TUSS,
	x.CD_TABELA,
	x.CD_TIPO_DESPESA_TUSS 
FROM 
(SELECT 
	a.CD_TUSS,
	a.DS_TUSS,
	a.CD_TABELA,
	a.CD_TIPO_DESPESA_TUSS 
FROM BI.BI_TUSS_TAB18 a 
UNION 
SELECT 
	b.CD_TUSS,
	b.DS_TUSS,
	b.CD_TABELA,
	b.CD_TIPO_DESPESA_TUSS 
FROM BI.BI_TUSS_TAB19 b 
UNION
SELECT 
	c.CD_TUSS,
	c.DS_TUSS,
	c.CD_TABELA,
	c.CD_TIPO_DESPESA_TUSS 
FROM BI.BI_TUSS_TAB20 c
UNION
SELECT 
	d.CD_TUSS,
	d.DS_TUSS,
	d.CD_TABELA,
	d.CD_TIPO_DESPESA_TUSS 
FROM BI.BI_TUSS_TAB22 d) x
ORDER BY x.CD_TABELA, x.CD_TUSS  ASC </sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>Cn_Oracle_Afrafep</connection>
