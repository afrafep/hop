  </transform>
  <transform>
    <type>TableInput</type>
    <name>procedimento_tuss</name>
    <sql>SELECT
	CD_GRUPO_PROCEDIMENTO,
	NM_GRUPO_PROCEDIMENTO,
	CD_SUBGRUPO_PROCEDIMENTO,
	NM_SUBGRUPO_PROCEDIMENTO,
	CD_PROCEDIMENTO,
	NM_PROCEDIMENTO,
	AUX,
	PA,
	INCID,
	QT_FILME,
	TIPO,
	DS_TIPO,
	PESO,
	PPROC,
	FAIXA_ETARIA_DE,
	FAIXA_ETARIA_ATE,
	PERIODO,
	VALIDADE_DE,
	VALIDADE_ATE,
	QT_MAX_VIDA,
	QT_MAX_GUIA,
	QT_CH_CUSTO,
	QT_CH_HONOR,
	CUSTO_HOSP,
	CUSTO_MAT,
	CUSTO_MED,
	VALOR_MEDIO,
	VL_FRANQUIA,
	CD_TUSS,
	DS_TUSS,
	ACOMODACAO,
	CARENCIA,
	PARAMETRO_UTILIZACAO,
	CD_ANVISA,
	ATIVO,
	SEXO,
	FL_DUT,
	ESP,
	AUTOR,
	PAC,
	AUTOR_WEB,
	REALIZA,
	CUSTO_MEDIO,
	PQA,
	AUDITORIA,
	CONTROLE_TRAT,
	COD_DUT,
	ROL_ANS
FROM
	BI.BI_PROCEDIMENTO_TUSS
WHERE CD_PROCEDIMENTO NOT IN (SELECT
	x.CD_PROCEDIMENTO
FROM
	BI.BI_PROCEDIMENTO_TUSS x
GROUP BY x.CD_PROCEDIMENTO 
HAVING COUNT(*) > 1)</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
