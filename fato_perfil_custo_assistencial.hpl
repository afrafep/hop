  <transform>
    <type>TableInput</type>
    <name>export_fato_despesa_assist_cidade_sexo</name>
    <sql>WITH base_despesa AS (
    SELECT 
        cd_usuario,
        fl_sexo,
        nu_cgc_cpf,
        nu_guia_atendimento,
        vl_procedimento_p
    FROM bi.tb_consolidacao_despesa
    WHERE dt_producao >= TRUNC(ADD_MONTHS(SYSDATE, -12), 'MM')
      AND cd_plano IN (50, 60, 9999)
      AND fl_tipo_autorizacao &lt;&gt; 'R'
      AND vl_procedimento_p > 0
),
base_geografica AS (
    SELECT 
        b.nm_cidade,
        b.cd_beneficiario,
        b.cd_uf,
        d.fl_sexo,
        d.nu_cgc_cpf,
        d.nu_guia_atendimento,
        d.vl_procedimento_p
    FROM base_despesa d
    INNER JOIN bi.bi_cadastro_beneficiario b 
        ON d.cd_usuario = b.cd_beneficiario
	WHERE b.ds_situacao_beneficiario = 'ATIVO'
	AND b.cd_plano_interno IN (50,60)
),
resultado_agrupado AS (
    SELECT
        NVL(UPPER(nm_cidade), 'NÃO INFORMADO') AS cidade,
        NVL(UPPER(cd_uf), 'XX') AS uf,
        fl_sexo,
        COUNT(DISTINCT cd_beneficiario) AS beneficiarios_univ_afetados,
        COUNT(nu_guia_atendimento) AS qtd_guias_atendimentos,
        SUM(vl_procedimento_p) AS custo_total,
        ROUND(SUM(vl_procedimento_p) / NULLIF(COUNT(DISTINCT nu_guia_atendimento), 0), 2) AS custo_medio_evento
    FROM base_geografica
    GROUP BY
        nm_cidade,
        cd_uf,
        fl_sexo
),
resultado_com_custo_cidade AS (
    SELECT
        cidade,
        uf,
        fl_sexo,
        beneficiarios_univ_afetados,
        qtd_guias_atendimentos,
        custo_total,
        custo_medio_evento,
        SUM(custo_total) OVER(PARTITION BY cidade, uf) AS custo_total_da_cidade
    FROM resultado_agrupado
)
SELECT
    cidade,
    uf,
    fl_sexo,
    beneficiarios_univ_afetados,
    qtd_guias_atendimentos,
    custo_total,
    custo_medio_evento,
    DENSE_RANK() OVER (ORDER BY custo_total_da_cidade DESC) AS ranking_custo_cidade
FROM resultado_com_custo_cidade
ORDER BY 
    ranking_custo_cidade ASC, 
    custo_total DESC</sql>
