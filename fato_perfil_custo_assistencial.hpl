  <transform>
    <type>TableInput</type>
    <name>export_fato_despesa_assist_faixa_etaria</name>
    <sql>WITH base_idade AS (
    SELECT 
    	cd_usuario,
        TRUNC(MONTHS_BETWEEN(TRUNC(SYSDATE), dt_nascimento) / 12) AS idade,
        fl_sexo,
        nu_cgc_cpf,
        nu_guia_atendimento,
        vl_procedimento_p
    FROM bi.tb_consolidacao_despesa
    WHERE dt_producao >= TRUNC(ADD_MONTHS(SYSDATE, -12), 'MM')
      AND cd_plano IN (50, 60, 9999)
      AND fl_tipo_autorizacao &lt;&gt; 'R'
      AND vl_procedimento_p > 0
),
base_faixa AS (
    SELECT 
    	cd_usuario,
        CASE 
            WHEN idade BETWEEN 0 AND 9   THEN '0 - 9 crianças'
            WHEN idade BETWEEN 10 AND 19 THEN '10 - 19 Adolescentes'
            WHEN idade BETWEEN 20 AND 29 THEN '20 - 29 Adultos Faixa I'
            WHEN idade BETWEEN 30 AND 39 THEN '30 - 39 Adultos Faixa II'
            WHEN idade BETWEEN 40 AND 49 THEN '40 - 49 Adultos Faixa III'
            WHEN idade BETWEEN 50 AND 59 THEN '50 - 59 Adultos Faixa IV'
            WHEN idade BETWEEN 60 AND 69 THEN '60 - 69 Idoso Faixa I'
            WHEN idade BETWEEN 70 AND 79 THEN '70 - 79 Idoso Faixa II'
            WHEN idade BETWEEN 80 AND 89 THEN '80 - 89 Idoso Faixa III'
            WHEN idade BETWEEN 90 AND 99 THEN '90 - 99 Idoso Faixa IV'
            ELSE '>= 100 Idoso Faixa V'
        END AS ds_faixa_etaria,
        fl_sexo,
        nu_cgc_cpf,
        nu_guia_atendimento,
        vl_procedimento_p
    FROM base_idade
),
resultado_agrupado AS (
    SELECT
        ds_faixa_etaria,
        fl_sexo,
        COUNT(DISTINCT cd_usuario) AS beneficiarios_univ_afetados,
        COUNT(nu_guia_atendimento) AS qtd_atendimentos,
        SUM(vl_procedimento_p) AS custo_total,
        ROUND(SUM(vl_procedimento_p) / NULLIF(COUNT(DISTINCT nu_guia_atendimento), 0), 2) AS custo_medio_evento
    FROM base_faixa
    GROUP BY
        ds_faixa_etaria,
        fl_sexo
)
SELECT
    ds_faixa_etaria,
    fl_sexo,
    beneficiarios_univ_afetados,
    qtd_atendimentos,
    custo_total,
    custo_medio_evento,
    DENSE_RANK() OVER (ORDER BY custo_total DESC) AS ranking_custo_geral
FROM resultado_agrupado
ORDER BY 
    ranking_custo_geral ASC</sql>
