  <transform>
    <type>TableInput</type>
    <name>export_fato_despesa_assist_cidade_sexo_faixa_etaria</name>
    <sql>WITH base_despesa AS (
    SELECT 
        cd_usuario,
        nu_cgc_cpf,
        nu_guia_atendimento,
        vl_procedimento_p
    FROM bi.tb_consolidacao_despesa
    WHERE dt_producao >= TRUNC(ADD_MONTHS(SYSDATE, -12), 'MM')
      AND cd_plano IN (50, 60, 9999)
      AND fl_tipo_autorizacao &lt;&gt; 'R'
      AND vl_procedimento_p > 0
),
base_cadastro AS (
    SELECT 
        b.cd_beneficiario,
        NVL(UPPER(b.nm_cidade), 'NÃO INFORMADO') AS cidade,
        NVL(UPPER(b.cd_uf), 'XX') AS uf,
        b.fl_sexo,
        TRUNC(MONTHS_BETWEEN(TRUNC(SYSDATE), b.dt_nascimento) / 12) AS idade
    FROM bi.bi_cadastro_beneficiario b
),
base_geografica_idade AS (
    SELECT 
        CASE 
        	WHEN c.cidade = 'JOÃO PESSOA' THEN 'JOAO PESSOA'
        	ELSE c.cidade
        END AS cidade,
        c.uf,
        c.fl_sexo,
        c.cd_beneficiario,
        CASE 
            WHEN c.idade BETWEEN 0 AND 9   THEN '0 - 9 crianças'
            WHEN c.idade BETWEEN 10 AND 19 THEN '10 - 19 Adolescentes'
            WHEN c.idade BETWEEN 20 AND 29 THEN '20 - 29 Adultos Faixa I'
            WHEN c.idade BETWEEN 30 AND 39 THEN '30 - 39 Adultos Faixa II'
            WHEN c.idade BETWEEN 40 AND 49 THEN '40 - 49 Adultos Faixa III'
            WHEN c.idade BETWEEN 50 AND 59 THEN '50 - 59 Adultos Faixa IV'
            WHEN c.idade BETWEEN 60 AND 69 THEN '60 - 69 Idoso Faixa I'
            WHEN c.idade BETWEEN 70 AND 79 THEN '70 - 79 Idoso Faixa II'
            WHEN c.idade BETWEEN 80 AND 89 THEN '80 - 89 Idoso Faixa III'
            WHEN c.idade BETWEEN 90 AND 99 THEN '90 - 99 Idoso Faixa IV'
            ELSE '>= 100 Idoso Faixa V'
        END AS ds_faixa_etaria,
        d.nu_cgc_cpf,
        d.nu_guia_atendimento,
        d.vl_procedimento_p
    FROM base_despesa d
    INNER JOIN base_cadastro c 
        ON d.cd_usuario = c.cd_beneficiario
),
resultado_agrupado AS (
    SELECT
        cidade,
        uf,
        ds_faixa_etaria,
        fl_sexo,
        COUNT(DISTINCT cd_beneficiario) AS benef_univ_afetados,
        COUNT(DISTINCT nu_guia_atendimento) AS qtd_guias_atendimentos,
        SUM(vl_procedimento_p) AS custo_total,
        ROUND(SUM(vl_procedimento_p) / NULLIF(COUNT(DISTINCT nu_guia_atendimento), 0), 2) AS custo_medio_evento
    FROM base_geografica_idade
    GROUP BY
        cidade,
        uf,
        ds_faixa_etaria,
        fl_sexo
),
resultado_com_custo_cidade AS (
    SELECT
        cidade,
        uf,
        ds_faixa_etaria,
        fl_sexo,
        benef_univ_afetados,
        qtd_guias_atendimentos,
        custo_total,
        custo_medio_evento --, SUM(custo_total) OVER(PARTITION BY cidade, uf) AS custo_total_da_cidade
    FROM resultado_agrupado
)
SELECT
    cidade,
    uf,
    ds_faixa_etaria,
    fl_sexo,
    benef_univ_afetados,
    qtd_guias_atendimentos,
    ROUND(custo_total,2) AS custo_total,
    custo_medio_evento 
FROM resultado_com_custo_cidade
ORDER BY 
     custo_total DESC,
	 ds_faixa_etaria ASC,
	 fl_sexo ASC,
	 cidade ASC,
	 uf ASC</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
