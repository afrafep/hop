  <transform>
    <type>TableInput</type>
    <name>export_fato_despesa_assist_faixa_etaria_tipo_atend</name>
    <sql>WITH base_idade AS (
    SELECT 
        TRUNC(MONTHS_BETWEEN(TRUNC(SYSDATE), dt_nascimento) / 12) AS idade,
        CASE 
            WHEN UPPER(TRIM(ds_tipo_atendimento_tiss)) IN ('CONSULTA ELETIVA', 'CONSULTA') THEN 'CONSULTA'
            WHEN UPPER(TRIM(ds_tipo_atendimento_tiss)) LIKE 'PRONTO SOCORRO%' THEN 'PRONTO SOCORRO'
            ELSE UPPER(TRIM(ds_tipo_atendimento_tiss))
        END AS ds_tipo_atendimento_tiss,
        vl_procedimento_p
    FROM bi.tb_consolidacao_despesa
    WHERE dt_producao >= TRUNC(ADD_MONTHS(SYSDATE, -12), 'MM')
      AND cd_plano IN (50, 60, 9999)
      AND fl_tipo_autorizacao &lt;&gt; 'R'
      AND vl_procedimento_p > 0
),
base_faixa AS (
    SELECT 
        CASE 
            WHEN idade BETWEEN 0 AND 9   THEN '0 - 9 crianças'
            WHEN idade BETWEEN 10 AND 19 THEN '10 - 19 Adolescentes'
            WHEN idade BETWEEN 20 AND 29 THEN '20 - 29 Adultos Faixa I'
            WHEN idade BETWEEN 30 AND 39 THEN '30 - 39 Adultos Faixa II'
            WHEN idade BETWEEN 40 AND 49 THEN '40 - 49 Adultos Faixa III'
            WHEN idade BETWEEN 50 AND 59 THEN '50 - 59 Adultos Faixa IV'
            WHEN idade BETWEEN 60 AND 69 THEN '60 - 69 Idoso Faixa I'
            WHEN idade BETWEEN 70 AND 79 THEN '70 - 79 Idoso Faixa II'
            WHEN idade BETWEEN 80 AND 89 THEN '80 - 89 Idoso Faixa III'
            WHEN idade BETWEEN 90 AND 99 THEN '90 - 99 Idoso Faixa IV'
            ELSE '>= 100 Idoso Faixa V'
        END AS ds_faixa_etaria,
        ds_tipo_atendimento_tiss,
        vl_procedimento_p
    FROM base_idade
)
SELECT 
    ds_faixa_etaria,
    ROUND(NVL(custo_consulta, 0),2) AS custo_consulta,
    ROUND(NVL(custo_peq_atendimento, 0),2) AS custo_peq_atendimento,
    ROUND(NVL(custo_quimioterapia, 0),2) AS custo_quimioterapia,
    ROUND(NVL(custo_exames, 0),2) AS custo_exames,
    ROUND(NVL(custo_pronto_socorro, 0),2) AS custo_pronto_socorro,
    ROUND(NVL(custo_terapias, 0),2) AS custo_terapias,
    ROUND(NVL(custo_radioterapia, 0),2) AS custo_radioterapia,
    ROUND(NVL(custo_remocao, 0),2) AS custo_remocao,
    ROUND(NVL(custo_peq_cirurgia, 0),2) AS custo_peq_cirurgia,
    ROUND(NVL(custo_sadt_internado, 0),2) AS custo_sadt_internado,
    ROUND(NVL(custo_atend_domiciliar, 0),2) AS custo_atend_domiciliar,
    ROUND(NVL(custo_trs, 0),2) AS custo_trs,
    ROUND(NVL(custo_conta_hospitalar, 0),2) AS custo_conta_hospitalar,
    ROUND((NVL(custo_consulta, 0) + NVL(custo_peq_atendimento, 0) + NVL(custo_quimioterapia, 0) + 
    NVL(custo_exames, 0) + NVL(custo_pronto_socorro, 0) + NVL(custo_terapias, 0) + 
    NVL(custo_radioterapia, 0) + NVL(custo_remocao, 0) + NVL(custo_peq_cirurgia, 0) + 
    NVL(custo_sadt_internado, 0) + NVL(custo_atend_domiciliar, 0) + NVL(custo_trs, 0) + 
    NVL(custo_conta_hospitalar, 0)),2) AS custo_total_faixa
FROM base_faixa
PIVOT (
    SUM(vl_procedimento_p) 
    FOR ds_tipo_atendimento_tiss IN (
        'CONSULTA' AS custo_consulta,
        'PEQUENO ATENDIMENTO (SUTURA, GESSO E OUTROS)' AS custo_peq_atendimento,
        'QUIMIOTERAPIA' AS custo_quimioterapia,
        'EXAMES' AS custo_exames,
        'PRONTO SOCORRO' AS custo_pronto_socorro,
        'TERAPIAS' AS custo_terapias,
        'RADIOTERAPIA' AS custo_radioterapia,
        'REMOÇÃO' AS custo_remocao,
        'PEQUENA CIRURGIA' AS custo_peq_cirurgia,
        'SADT INTERNADO' AS custo_sadt_internado,
        'ATENDIMENTO DOMICILIAR' AS custo_atend_domiciliar,
        'TERAPIA RENAL SUBSTITUTIVA (TRS)' AS custo_trs,
        'CONTA HOSPITALAR' AS custo_conta_hospitalar
    )
)
ORDER BY ds_faixa_etaria ASC</sql>
