  <transform>
    <type>TableInput</type>
    <name>vw_demonstrativo_analise_conta</name>
    <sql>SELECT
	TO_NUMBER(ac.NU_GUIA_MTISS) AS NU_GUIA_MTISS,
	ac.DT_PRODUCAO,
	CASE 
		WHEN LENGTH(ac.NU_CGC_CPF) &lt; 11 THEN LPAD(ac.NU_CGC_CPF,11,0)
		WHEN LENGTH(ac.NU_CGC_CPF) > 11 AND  LENGTH(ac.NU_CGC_CPF) &lt; 14 THEN LPAD(ac.NU_CGC_CPF,14,0)
		ELSE TO_CHAR(ac.NU_CGC_CPF)
	END AS NU_CGC_CPF,
	ac.CD_TIPO_TRATAMENTO,
	CASE 
		WHEN ac.CD_TIPO_TRATAMENTO = 0 THEN 'CONSULTAS'
		WHEN ac.CD_TIPO_TRATAMENTO = 1 THEN 'CLINICO'
		WHEN ac.CD_TIPO_TRATAMENTO = 2 THEN 'CIRURGICO'
		WHEN ac.CD_TIPO_TRATAMENTO = 3 THEN 'OBSTETRICO'
		WHEN ac.CD_TIPO_TRATAMENTO = 4 THEN 'PEDIATRICA'
		WHEN ac.CD_TIPO_TRATAMENTO = 5 THEN 'PSIQUIATRICA'	
		WHEN ac.CD_TIPO_TRATAMENTO = 6 THEN 'MAT/MED/ATEND.SAD'
	END AS DS_TIPO_TRATAMENTO,
	ac.CD_SERVICO,
	CASE 
		WHEN ac.CD_SERVICO = 1 THEN 'CONSULTA'
		WHEN ac.CD_SERVICO = 2 THEN 'SP/SADT'
		WHEN ac.CD_SERVICO = 3	THEN 'RESUMO DE INTERNAÇÃO'
		WHEN ac.CD_SERVICO = 4 THEN 'TRATAMENTO ODONTOLÓGICO'
		WHEN ac.CD_SERVICO = 5 THEN 'HONORÁRIOS'
		WHEN ac.CD_SERVICO = 9 THEN 'REEMBOLSO'
	END AS DS_SERVICO,	
	ac.DT_ENTREGA AS DT_HRA_ENTREGA_PROC,
	ac.DT_DIGITACAO AS DT_DIGITACAO_GUIA_PORC,
	ac.DATA_REALIZACAO,
	ac.DT_PAGAMENTO,
	ac.PROCESSO,
	ac.GUIA,
	ac.CD_SENHA_PRINCIPAL,
	ac.CD_SENHA_AUTORIZACAO,
	ac.CD_USUARIO,
	ac.NU_ITEM_DOCUMENTO,
	ac.CD_PROCEDIMENTO,
	ac.NM_PROCEDIMENTO,
	ac.DS_TIPO_DESPESA,
	ac.QT_SERVICO_PRESTADO,
	ac.VL_SERVICO_PRESTADO,
	ac.QT_PROCEDIMENTO,
	ac.VL_PROCEDIMENTO,
	ac.VL_GLOSA,
	ac.QT_PROCEDIMENTO_P,
	ac.VL_PROCEDIMENTO_P,
	ac.VL_COPARTICIPACAO,
	ac.VL_PROCEDIMENTO_RAT,
	ac.COMPLEMENTO AS OBS_FINANCEIRAS_AUTORIZACAO,
	ac.FL_NIVEL_ERRO,
	CASE
		WHEN ac.ERRO = ' '
		AND ac.VL_GLOSA > 0 THEN 'GUIA GLOSADA - SEM INFORMAÇÃO DO MOTIVO DA GLOSA'
		WHEN ac.ERRO IS NULL
		AND ac.VL_GLOSA > 0 THEN 'GUIA GLOSADA - SEM INFORMAÇÃO DO MOTIVO DA GLOSA'
		WHEN ac.ERRO IS NULL
		AND ac.VL_GLOSA = 0 THEN 'SEM GLOSA'
		WHEN ac.ERRO = ' '
		AND ac.VL_GLOSA = 0 THEN 'SEM GLOSA'
		ELSE ac.ERRO
	END AS ERRO_TRATADO,
	ac.CD_TAB,
	ac.CD_SERV_TISS,
	ac.TIPO_PROCESSO,
	ac.CD_TIPO_ATENDIMENTO_TISS,
	ac.DS_TIPO_ATENDIMENTO_TISS,
	ac.CD_TIPO_INTERNACAO_TISS,
	ac.DS_TIPO_INTERNACAO_TISS,
	ac.DS_TIPO_EVENTO,
	ac.CD_PLANO,
	ac.DS_TIPO_GUIA_AUTOR
FROM
	bi.BI_DEMONSTRATIVO_ANALISE_CONTA ac
WHERE DT_PRODUCAO between add_months(trunc(sysdate,'month'),-48) 
	AND add_months(trunc(sysdate,'month'),-1)
-- ORDER BY ac.DT_PRODUCAO DESC</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
