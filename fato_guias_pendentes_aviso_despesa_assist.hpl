  <transform>
    <type>TableInput</type>
    <name>export_guias_pendentes_aviso_despesa_assist</name>
    <sql>WITH lista_producao_faturada AS (
    SELECT DISTINCT 
        d.cd_senha_autorizacao AS cd_senha, 
        d.guia
    FROM bi.bi_analise_producao d
    WHERE d.dt_producao >= TRUNC(ADD_MONTHS(SYSDATE, -18), 'MM')
),
guias_ausentes_base AS (
    SELECT
        TRUNC(ap.data_autorizacao, 'MM') AS dt_competencia,
        CASE 
			WHEN LENGTH(ap.cpf_cnpj_credenciado) &lt; 11 THEN LPAD(ap.cpf_cnpj_credenciado,11,0)
			WHEN LENGTH(ap.cpf_cnpj_credenciado) > 11 AND  LENGTH(ap.cpf_cnpj_credenciado) &lt; 14 THEN LPAD(ap.cpf_cnpj_credenciado,14,0)
			ELSE TO_CHAR(ap.cpf_cnpj_credenciado)
		END AS cpf_cnpj_credenciado,
        ap.nome_credenciado,
        ap.cd_senha,
        ap.guia,
        ap.cod_beneficiario,
        ap.data_autorizacao,
        ap.dt_alta,
        ap.desc_tipo_autor,
        ap.cod_status_autor,
        ap.desc_status_autor,
        ap.cod_procedimento,
        ap.desc_procedimento,
        ap.qt_procedimento,
        ROUND(ap.vl_total,2) AS vl_autorizado,
        TRUNC(SYSDATE) - TRUNC(ap.data_autorizacao) AS dias_sem_faturamento,
        CASE 
        	WHEN TRUNC(SYSDATE) - TRUNC(ap.data_autorizacao) &lt;= 30 THEN 'DENTRO DO PRAZO'
        	WHEN TRUNC(SYSDATE) - TRUNC(ap.data_autorizacao) &lt;= 60 THEN 'ATENCAO (31-60 dias)'
        	WHEN TRUNC(SYSDATE) - TRUNC(ap.data_autorizacao) &lt;= 90 THEN 'CRITICO (61-90 dias)'
        	ELSE 'VENCIDO (>90 dias)'
        END AS situacao_prazo_senha
    FROM bi.bi_autorizacao_procedimento ap
    LEFT JOIN lista_producao_faturada prod ON 
        ap.cd_senha = prod.cd_senha
        AND ap.guia = prod.guia
    WHERE ap.data_autorizacao >= TRUNC(ADD_MONTHS(SYSDATE, -12), 'MM') 
      AND ap.data_autorizacao &lt; TRUNC(SYSDATE, 'MM')
      AND ap.cod_status_autor IN (1, 2) 
      AND prod.guia IS NULL
)
SELECT
    TO_CHAR(dt_competencia, 'MM-YYYY') AS COMPETENCIA,
    cpf_cnpj_credenciado,
    nome_credenciado,
    cd_senha,
    guia,
    cod_beneficiario,
    data_autorizacao,
    dt_alta,
    desc_tipo_autor,
    cod_status_autor,
    desc_status_autor,
    cod_procedimento,
    desc_procedimento,
    qt_procedimento,
    vl_autorizado,
    dias_sem_faturamento,
    situacao_prazo_senha
FROM guias_ausentes_base
ORDER BY
    dt_competencia DESC,
    situacao_prazo_senha ASC,
    dias_sem_faturamento DESC NULLS LAST</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>Cn_Oracle_Afrafep</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
