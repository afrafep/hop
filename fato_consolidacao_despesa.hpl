  <transform>
    <type>TableInput</type>
    <name>export_consolidacao_despesa</name>
    <sql>SELECT
	TO_NUMBER(NU_GUIA_MTISS) AS NU_GUIA_MTISS,
	DT_PRODUCAO,
	CD_USUARIO AS CD_BENEFICIARIO,
	NU_ORDEM AS PROCESSO,
	NU_GUIA_ATENDIMENTO AS GUIA,
	CD_SENHA,
	DT_AUTORIZACAO,
	DT_ATENDIMENTO,
	DT_PAGAMENTO,
	FL_TIPO_AUTORIZACAO,
	CD_PROCEDIMENTO,
	NVL (DS_PROCEDIMENTO,'PROCEDIMENTO NAO INFORMADO') AS DS_PROCEDIMENTO,
	QT_PROCEDIMENTO,
	-- Valor Procedimento pago,
	ROUND(VL_PROCEDIMENTO_P,2) AS VL_PROCEDIMENTO_PAGO,
	-- Valor Procedimento rateado,
	VL_PROCEDIMENTO_RAT AS VL_PROCEDIMENTO_RATEADO,
	CD_PLANO,
	FL_URGENCIA,
	CD_CID,
	DS_CID,
	CD_TIPO_TRATAMENTO,
	DS_TIPO_TRATAMENTO,
	CD_SERVICO,
	DS_SERVICO,
	CD_TIPO_SERVICO,
	DS_TIPO_SERVICO,
	CD_ESPECIALIDADE,
	DS_TIPO_AUTORIZACAO,
	DS_TIPO_PROCESSO,
	CD_TIPO_INTERNACAO,
	DS_TIPO_INTERNACAO,
	CD_REGIME_INTERNACAO_TISS,
	DS_REGIME_INTERNACAO_TISS,
	CD_TIPO_DESPESAS_UNIDAS,
	DS_TIPO_DESPESAS_UNIDAS 
	CD_TIPO_ATENDIMENTO,
	DS_TIPO_ATENDIMENTO,
	DS_CARATER_ATENDIMENTO,
	CD_PARAMETRO,
	NVL (DS_PARAMETRO,'PARAMETRO INEXISTENTE') AS DS_PARAMETRO,
	CD_TIPO_ATO,
	DS_TIPO_ATO,
	CD_PPS,
	DS_PPS,
	NU_GUIA_PRINCIPAL,
	NU_DOCUMENTO,
	CD_OBRIGACAO,
	VL_PARCERIA AS VL_CO_PART,
	VL_PERDA_PARCERIA,
	PC_TAXA_ADMINISTRATIVA,
	VL_TAXA_ADMINISTRATIVA,
	DS_TIPO_ATENDIMENTO_TISS,
	CD_TIPO_ATENDIMENTO_TISS,
	CD_MEDICO_SOLICITANTE,
	NM_MEDICO_SOLICITANTE,
	CASE 
		WHEN LENGTH(CPF_CNPJ_SOLICITANTE) &lt; 11 THEN LPAD(CPF_CNPJ_SOLICITANTE,11,0)
		WHEN LENGTH(CPF_CNPJ_SOLICITANTE) > 11 AND  LENGTH(CPF_CNPJ_SOLICITANTE) &lt; 14 THEN LPAD(CPF_CNPJ_SOLICITANTE,14,0)
		ELSE TO_CHAR(CPF_CNPJ_SOLICITANTE)
	END AS 	CPF_CNPJ_SOLICITANTE,
	NM_CREDENCIADO_SOLICITANTE,
	LPAD(CPF_PROF_EXECUTANTE,11,0) AS CPF_PROF_EXECUTANTE,
	NM_PROF_EXECUTANTE,
	LPAD(NU_CPF_MEDICO_GUIA,11,0) AS NU_CPF_MEDICO_GUIA,
	NM_MEDICO_GUIA,
	CASE 
		WHEN LENGTH(NU_CGC_PRESTADOR) &lt; 11 THEN LPAD(NU_CGC_PRESTADOR,11,0)
		WHEN LENGTH(NU_CGC_PRESTADOR) > 11 AND  LENGTH(NU_CGC_PRESTADOR) &lt; 14 THEN LPAD(NU_CGC_PRESTADOR,14,0)
		ELSE TO_CHAR(NU_CGC_PRESTADOR)
	END	 AS NU_CPF_CNPJ_PRESTADOR,
	NM_PRESTADOR_GUIA
FROM TB_CONSOLIDACAO_DESPESA d
WHERE d.DT_PRODUCAO between add_months(trunc(sysdate,'month'),-48) --TO_DATE('01/01/2026','DD/MM/YYYY') 
	AND add_months(trunc(sysdate,'month'),-1)
 </sql>
    <limit>0</limit>
