  <transform>
    <type>TableInput</type>
    <name>export_despesa_mat_med</name>
    <sql>SELECT
	mm.DT_PRODUCAO,
	mm.NU_ORDEM,
	mm.NU_GUIA_ATENDIMENTO,
	mm.CD_SENHA,
	CASE 
		WHEN LENGTH(mm.NU_CGC_CPF) &lt; 11 THEN LPAD(mm.NU_CGC_CPF,11,0)
		WHEN LENGTH(mm.NU_CGC_CPF) > 11 AND  LENGTH(mm.NU_CGC_CPF) &lt; 14 THEN LPAD(mm.NU_CGC_CPF,14,0)
		ELSE TO_CHAR(mm.NU_CGC_CPF)
	END AS nu_cpf_cnpj,
	mm.NU_ORDEM_MAT_MED_GUIA,
	mm.CD_TIPO_SERVICO,
	CASE 
		WHEN LENGTH(mm.CD_MAT_MED) &lt;=5 THEN mm.CD_MAT_MED_TISS
		ELSE to_char(mm.CD_MAT_MED)
	END AS cd_mat_med,
	mm.DS_MAT_MED_GUIA,
	mm.CD_TABELA_TISS,
	mm.CD_TIPO_DESP_TISS,
	mm.CD_TUSS,
	mm.CD_UNIDADE,
	mm.DT_MAT_MED,
	CASE 
		WHEN mm.HR_INICIAL IS NULL THEN NULL 
		ELSE TO_CHAR(TRUNC(mm.HR_INICIAL / 3600), 'FM00') || ':' ||
 			 TO_CHAR(TRUNC(MOD(mm.HR_INICIAL, 3600) / 60), 'FM00') || ':' ||
			 TO_CHAR(MOD(MOD(mm.HR_INICIAL, 3600), 60), 'FM00') 
	END AS nr_inicial,
	CASE 
		WHEN mm.HR_FINAL IS NULL THEN NULL 
		ELSE TO_CHAR(TRUNC(mm.HR_FINAL / 3600), 'FM00') || ':' ||
 			 TO_CHAR(TRUNC(MOD(mm.HR_FINAL, 3600) / 60), 'FM00') || ':' ||
			 TO_CHAR(MOD(MOD(mm.HR_FINAL, 3600), 60), 'FM00') 
	END AS hr_final,
	mm.PC_THM,
	mm.QT_MAT_MED_GUIA AS qtd_mat_med_info,
	mm.VL_MAT_MED_GUIA AS vl_mat_med_unitario_info,
	mm.VL_TOT_MAT_MED_GUIA AS vl_total_mat_med_info,
	mm.QT_MAT_MED_GUIA_P AS qt_mat_med_pago,
	mm.VL_MAT_MED_GUIA_P AS vl_total_mat_med_pago
FROM
	BI.BI_DET_MAT_MED_GUIA mm
WHERE mm.DT_PRODUCAO between add_months(trunc(sysdate,'month'),-48) --TO_DATE('01/01/2026','DD/MM/YYYY') 
	AND add_months(trunc(sysdate,'month'),-1)</sql>
