    <name>contribuicao_saude</name>
    <sql>SELECT
  CD_OBRIGACAO
, CD_CEDENTE_SACADO
, MATRICULA
, NM_TITULAR
, DT_COMPETENCIA
, DT_EMISSAO
, DT_VENCIMENTO
, DT_STATUS
, CD_STATUS
, DS_STATUS
, VL_SALDO_OBRIGACAO
, VL_OBRIGACAO
, CD_ESPECIE_TITULO
FROM BI.BI_CONTRIBUICAO_SAUDE
WHERE DT_COMPETENCIA BETWEEN add_months(trunc(sysdate, 'month'),-48) 
		AND add_months(trunc(sysdate, 'month'),-1)
</sql>
